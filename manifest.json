{
  "manifest_version": 3,
  "name": "SmartStore Helper",
  "version": "1.1",
  "description": "스마트스토어 상품 복사 등록 시 일부 항목만 수정하는 도우미",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://sell.smartstore.naver.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://sell.smartstore.naver.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartStore Helper"
  }
}